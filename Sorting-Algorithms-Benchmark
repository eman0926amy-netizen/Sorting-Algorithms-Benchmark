package sortingbenchmark;

import java.util.Arrays;
import java.util.Random;

/**
 * Sorting-Algorithms-Benchmark
 * قياس زمن تنفيذ خمس خوارزميات ترتيب بالميكروثانية
 * على أربع حالات من البيانات (حجم المصفوفة N = 100,000).
 */
public class SortingBenchmark {

    static final int N = 100_000;
    static final long SEED = 42L; // بذرة ثابتة لتكرار نفس البيانات في كل تشغيل

    // أسماء الخوارزميات وحالات الاختبار (لطباعة الجدول)
    static final String[] ALGOS = {"Selection Sort", "Insertion Sort", "Bubble Sort", "Merge Sort", "Quick Sort"};
    static final String[] CASES = {"Random", "Reversed", "Partial 80%", "Sorted"};

    // ===================== توليد البيانات =====================

    /** مصفوفة عشوائية تماماً */
    static int[] generateRandom(Random rnd) {
        int[] a = new int[N];
        for (int i = 0; i < N; i++) a[i] = rnd.nextInt(1_000_000);
        return a;
    }

    /** مصفوفة مرتبة تصاعدياً */
    static int[] generateSorted(Random rnd) {
        int[] a = generateRandom(rnd);
        Arrays.sort(a);
        return a;
    }

    /** مصفوفة مرتبة عكسياً (من الأكبر إلى الأصغر) */
    static int[] generateReversed(Random rnd) {
        int[] a = generateSorted(rnd);
        for (int i = 0, j = N - 1; i < j; i++, j--) {
            int t = a[i]; a[i] = a[j]; a[j] = t;
        }
        return a;
    }

    /** مصفوفة مرتبة جزئياً: ~80% في مكانها الصحيح و ~20% عناصر مبعثرة عشوائياً */
    static int[] generatePartiallySorted(Random rnd) {
        int[] a = generateSorted(rnd);
        int swaps = (int) (N * 0.20 / 2); // كل عملية تبديل تُزيح عنصرين => 20% تقريباً
        for (int k = 0; k < swaps; k++) {
            int i = rnd.nextInt(N), j = rnd.nextInt(N);
            int t = a[i]; a[i] = a[j]; a[j] = t;
        }
        return a;
    }

    // ===================== خوارزميات الترتيب =====================

    /** Selection Sort: O(N^2) في جميع الحالات */
    static void selectionSort(int[] a) {
        int n = a.length;
        for (int i = 0; i < n - 1; i++) {
            int min = i;
            for (int j = i + 1; j < n; j++) {
                if (a[j] < a[min]) min = j;
            }
            int t = a[min]; a[min] = a[i]; a[i] = t;
        }
    }

    /** Insertion Sort: O(N^2) في الأسوأ، O(N) إذا كانت المصفوفة مرتبة */
    static void insertionSort(int[] a) {
        for (int i = 1; i < a.length; i++) {
            int key = a[i];
            int j = i - 1;
            while (j >= 0 && a[j] > key) {
                a[j + 1] = a[j];
                j--;
            }
            a[j + 1] = key;
        }
    }

    /** Bubble Sort مع توقف مبكر إذا لم يحدث أي تبديل: O(N) في الأفضل */
    static void bubbleSort(int[] a) {
        int n = a.length;
        for (int i = 0; i < n - 1; i++) {
            boolean swapped = false;
            for (int j = 0; j < n - 1 - i; j++) {
                if (a[j] > a[j + 1]) {
                    int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t;
                    swapped = true;
                }
            }
            if (!swapped) break; // المصفوفة أصبحت مرتبة
        }
    }

    /** Merge Sort: O(N log N) في جميع الحالات */
    static void mergeSort(int[] a, int left, int right) {
        if (left >= right) return;
        int mid = left + (right - left) / 2;
        mergeSort(a, left, mid);
        mergeSort(a, mid + 1, right);
        merge(a, left, mid, right);
    }

    private static void merge(int[] a, int left, int mid, int right) {
        int[] L = Arrays.copyOfRange(a, left, mid + 1);
        int[] R = Arrays.copyOfRange(a, mid + 1, right + 1);
        int i = 0, j = 0, k = left;
        while (i < L.length && j < R.length) {
            a[k++] = (L[i] <= R[j]) ? L[i++] : R[j++];
        }
        while (i < L.length) a[k++] = L[i++];
        while (j < R.length) a[k++] = R[j++];
    }

    /**
     * Quick Sort: المحور (Pivot) = العنصر الأخير (تقسيم Lomuto).
     * O(N log N) في المتوسط، لكن O(N^2) إذا كانت المصفوفة مرتبة/معكوسة
     * لأن المحور يكون دائماً أصغر أو أكبر عنصر.
     */
    static void quickSort(int[] a, int low, int high) {
        if (low < high) {
            int p = partition(a, low, high);
            quickSort(a, low, p - 1);
            quickSort(a, p + 1, high);
        }
    }

    private static int partition(int[] a, int low, int high) {
        int pivot = a[high];
        int i = low - 1;
        for (int j = low; j < high; j++) {
            if (a[j] <= pivot) {
                i++;
                int t = a[i]; a[i] = a[j]; a[j] = t;
            }
        }
        int t = a[i + 1]; a[i + 1] = a[high]; a[high] = t;
        return i + 1;
    }

    // ===================== القياس =====================

    /** تشغيل الخوارزمية رقم algo على نسخة من المصفوفة وإرجاع الزمن بالميكروثانية */
    static long measure(int algo, int[] original) {
        // 1. نسخة مستقلة ومطابقة للبيانات الأصلية (لا يدخل زمن النسخ في القياس)
        int[] testArray = Arrays.copyOf(original, original.length);

        // 2. تسجيل وقت البداية بالنانوثانية
        long startTime = System.nanoTime();

        // 3. استدعاء خوارزمية الترتيب
        switch (algo) {
            case 0: selectionSort(testArray); break;
            case 1: insertionSort(testArray); break;
            case 2: bubbleSort(testArray); break;
            case 3: mergeSort(testArray, 0, testArray.length - 1); break;
            case 4: quickSort(testArray, 0, testArray.length - 1); break;
        }

        // 4. تسجيل وقت النهاية وتحويله إلى ميكروثانية
        long endTime = System.nanoTime();
        long durationInMicroseconds = (endTime - startTime) / 1000;

        // التحقق من صحة الترتيب (خارج القياس)
        if (!isSorted(testArray)) {
            throw new IllegalStateException("الخوارزمية " + ALGOS[algo] + " لم ترتب المصفوفة بشكل صحيح!");
        }
        return durationInMicroseconds;
    }

    static boolean isSorted(int[] a) {
        for (int i = 1; i < a.length; i++) if (a[i - 1] > a[i]) return false;
        return true;
    }

    // ===================== البرنامج الرئيسي =====================

    public static void main(String[] args) throws Exception {
        // Quick Sort بمحور أخير يحتاج عمق استدعاءات ~N في الحالة الأسوأ،
        // لذلك نشغّل البرنامج في Thread بحجم ذاكرة stack كبير لتجنب StackOverflowError.
        Thread t = new Thread(null, SortingBenchmark::run, "benchmark", 1L << 29);
        t.start();
        t.join();
    }

    static void run() {
        Random rnd = new Random(SEED);

        // توليد حالات الاختبار الأربع
        int[][] datasets = {
            generateRandom(rnd),
            generateReversed(rnd),
            generatePartiallySorted(rnd),
            generateSorted(rnd)
        };

        // إحماء JVM (Warm-up) على مصفوفة صغيرة حتى لا تتأثر أول قياسات بالـ JIT
        int[] warm = new Random(1).ints(2000, 0, 10000).toArray();
        for (int w = 0; w < 5; w++)
            for (int algo = 0; algo < 5; algo++) measure(algo, warm);

        long[][] results = new long[5][4];
        for (int algo = 0; algo < 5; algo++) {
            for (int c = 0; c < 4; c++) {
                results[algo][c] = measure(algo, datasets[c]);
            }
        }

        // طباعة الجدول المنظم
        System.out.println("N = " + N + "   (times in microseconds, us)");
        System.out.println();
        System.out.printf("%-16s | %-14s | %-14s | %-14s | %-14s%n",
                "Algorithm", "Random", "Reversed", "Partial 80%", "Sorted");
        for (int d = 0; d < 86; d++) System.out.print("-");
        System.out.println();
        for (int algo = 0; algo < 5; algo++) {
            System.out.printf("%-16s | %,11d us | %,11d us | %,11d us | %,11d us%n",
                    ALGOS[algo], results[algo][0], results[algo][1], results[algo][2], results[algo][3]);
        }
    }
}
